# Azure OpenAI
API_KEY=your-azure-openai-api-key

# SurrealDB (defaults shown)
DB_USER=root
DB_PSW=root

# Mock data mode (set to false to use real web scraping APIs)
USE_MOCK=true

# Ollama model name (used by parse.py for knowledge graph extraction)
OLLAMA_MODEL=llama3

# Path to PDF document to process
DOCUMENT_PATH=path/to/your/document.pdf
